<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_detail_date_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:text="Date Title"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date:"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_detail_date_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jan 1, 2023"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Type:"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_detail_date_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Anniversary"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recurring:"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_detail_date_recurring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yes"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reminder:"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_detail_date_reminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enabled"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_edit_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_edit"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_delete_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_delete" />

    </LinearLayout>
</ScrollView>
