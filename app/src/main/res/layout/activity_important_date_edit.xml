<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Important Date"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_date_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_event_title"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_date_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tap to pick date"
            android:layout_marginBottom="12dp"
            android:focusable="false"
            android:inputType="text" />

        <Spinner
            android:id="@+id/sp_date_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:entries="@array/date_types" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <CheckBox
                android:id="@+id/cb_date_recurring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Repeats yearly" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <CheckBox
                android:id="@+id/cb_date_reminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable reminder" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_cancel_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel" />

    </LinearLayout>
</ScrollView>
